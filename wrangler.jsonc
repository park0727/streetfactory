{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ridermania",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "ridermania" }
  ],
  "observability": { "enabled": true },
  // 주소별 화면은 src/proxy.ts + src/lib/site.ts: 홈(회사 소개) / shop.(거래처 주문) / admin.(관리자). www 는 홈으로.
  // workers.dev 주소는 쓰지 않는다. 접속은 아래 도메인만.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "ridermania.co.kr", "custom_domain": true },
    { "pattern": "www.ridermania.co.kr", "custom_domain": true },
    { "pattern": "shop.ridermania.co.kr", "custom_domain": true },
    { "pattern": "admin.ridermania.co.kr", "custom_domain": true }
  ],
  // DB(서울) 근처에서 Worker 를 실행하도록 배치 (요청이 먼 PoP 로 들어와도 DB 왕복이 짧아진다)
  "placement": { "mode": "smart" },
  // Supabase 세션 풀러(5432) 를 원본으로 하는 Hyperdrive. 연결 풀을 DB 근처에 유지한다.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "a1ea4317cb5a4167a931bbdb151a289e" }]
  // 비밀값(DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY 등)은 `wrangler secret put` 으로 등록.
  // 공개값(NEXT_PUBLIC_*)은 빌드 시 .env 에서 인라인됨.
}
