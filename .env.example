# ---- .env.local (공개값) ----
# Supabase 대시보드 > Connect > Framework(Next.js) 탭에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# ---- .env.secrets (로컬 전용 비밀값. Next 규칙 밖 파일명이라 번들에 포함되지 않음) ----
# Settings > API Keys > Secret keys 탭에서 생성
SUPABASE_SECRET_KEY=sb_secret_xxxx
# Connect > Direct(Connection string). [YOUR-PASSWORD] 를 DB 비밀번호로 교체 (% 는 %25 로 인코딩)
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# 프로덕션(Cloudflare) 은 다음을 wrangler secret put 으로 등록:
#   DATABASE_URL, SUPABASE_SECRET_KEY, NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
